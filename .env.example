# Copy to .env.local and fill in your keys. All are optional:
# the app runs fully in free mode when unset.

# Clerk (https://dashboard.clerk.com) — publishable key, e.g. pk_live_...
VITE_CLERK_PUBLISHABLE_KEY=

# RevenueCat (https://app.revenuecat.com) — public Apple API key, e.g. appl_...
VITE_REVENUECAT_APPLE_API_KEY=

# AdMob banner ad unit ID, e.g. ca-app-pub-XXXXXXXXXXXXXXXX/NNNNNNNNNN
# (use ca-app-pub-3940256099942544/2934735716 for Apple's test banner)
VITE_ADMOB_BANNER_AD_ID=

# Set to "true" to preview premium features in local/web development
VITE_PREMIUM_PREVIEW=
